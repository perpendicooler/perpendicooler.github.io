
---
import BaseLayout from "../layouts/BaseLayout.astro";

const indesoreWebsite = "https://www.indesore.com/";
const indesoreLinkedIn =
  "https://www.linkedin.com/company/indesoregroup/";

const salahUddinProfile =
  "https://www.sust.edu/departments/mat/faculty/salahuddin-mat%40sust.edu";

const timeline = [
  {
    period: "2019–2024",
    label: "Education",
    title: "B.Sc. in Mathematics",
    sub: "Shahjalal University of Science and Technology (SUST), Sylhet",
    copy: "CGPA: 3.28/4.00. Mathematical training in algebra, numerical methods, mathematical programming, and analytical problem-solving.",
  },
  {
    period: "Sep 2023 – May 2024",
    label: "Research",
    title: "Research Student · SUST Research Center",
    sub: "Project investigator: Dr. Mohammad Salah Uddin",
    copy: "Investigated matrix methods for combinatorial aspects of posets and lattices, with MATLAB-based computational exploration. Project No. PS/2023/1/19.",
  },
  {
    period: "Jun 2024 – Present",
    label: "Industry",
    title: "Business Intelligence Analyst · INDESORE Group",
    sub: "Dhaka, Bangladesh",
    copy: "Develop production-capacity, efficiency, machine-utilization, SMV-prediction, downtime, and resource-allocation analytics for manufacturing operations.",
  },
];

const awards = [
  "Champion — Mechnovation 2022, SUST",
  "Champion — Mechnovation 2019, SUST",
  "Top 20 in Bangladesh — Knights Cubing Open 2019 (WCA)",
];
---

<BaseLayout
  title="About | Md Arif Hossain"
  description="Academic background, mathematical research, industrial analytics experience, and research interests of Md Arif Hossain."
>
  <div class="about-page">

    <!-- PAGE INTRODUCTION -->
    <header class="about-hero">
      <p class="about-label">BACKGROUND / JOURNEY</p>

      <h1>
        Curiosity about mathematics.
        <em> Motivation to apply it.</em>
      </h1>

      <p class="about-lead">
        I began in pure and computational mathematics and found
        a new set of questions in industrial systems: how can
        models allocate scarce resources, anticipate uncertainty,
        and help organizations make better decisions?
      </p>
    </header>

    <!-- ABOUT ME -->
    <section class="about-section split-section">
      <div class="section-heading">
        <p class="about-label">AT A GLANCE</p>
        <h2>About me</h2>
      </div>

      <div class="section-content">
        <p>
          I am <strong>Md Arif Hossain</strong>, a Mathematics
          graduate from
          <a
            href="https://www.sust.edu/"
            target="_blank"
            rel="noopener noreferrer"
          >Shahjalal University of Science and Technology (SUST)</a>,
          Bangladesh, and a Business Intelligence Analyst at
          <a
            href={indesoreWebsite}
            target="_blank"
            rel="noopener noreferrer"
          ><strong>INDESORE Group</strong></a>.
          You can also find the organization on
          <a
            href={indesoreLinkedIn}
            target="_blank"
            rel="noopener noreferrer"
          >LinkedIn ↗</a>.
        </p>

        <p>
          At SUST, I worked on computational methods for
          <strong>partially ordered sets and lattices</strong>
          under the guidance of
          <a
            href={salahUddinProfile}
            target="_blank"
            rel="noopener noreferrer"
          ><strong>Dr. Mohammad Salah Uddin</strong></a>.
          I also completed an undergraduate thesis on
          determinants, inverses, and eigenvalues of infinite
          matrices. These experiences shaped my interest in
          rigorous mathematical analysis and computation.
        </p>

        <p>
          In professional practice, I have worked with production
          planning, Standard Minute Value estimation, capacity
          feasibility, efficiency, and operational decision
          support. Working with the constraints and uncertainty
          of manufacturing operations has deepened my interest in
          <strong>
            operations research, mixed-integer programming,
            and large-scale optimization.
          </strong>
        </p>

        <p>
          I am interested in pursuing PhD research that connects
          mathematical theory, algorithms, and practical
          decision-making in manufacturing and supply-chain
          systems.
        </p>
      </div>
    </section>

    <!-- EDUCATION, RESEARCH AND EXPERIENCE -->
    <section class="about-section milestones-section">
      <div class="section-heading">
        <p class="about-label">
          EDUCATION · RESEARCH · EXPERIENCE
        </p>
        <h2>Selected milestones</h2>
      </div>

      <div class="timeline-list">
        {timeline.map((item) => (
          <article class="milestone">
            <div class="milestone-period">
              {item.period}
            </div>

            <div class="milestone-content">
              <span class="milestone-label">
                {item.label}
              </span>

              <h3>{item.title}</h3>

              <p class="milestone-sub">
                {item.sub}
              </p>

              <p>{item.copy}</p>

              {item.label === "Research" && (
                <div class="milestone-links">
                  <a
                    href={salahUddinProfile}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Supervisor's SUST profile ↗
                  </a>
                </div>
              )}

              {item.label === "Industry" && (
                <div class="milestone-links">
                  <a
                    href={indesoreWebsite}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Official Website ↗
                  </a>

                  <span aria-hidden="true">·</span>

                  <a
                    href={indesoreLinkedIn}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    LinkedIn ↗
                  </a>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- UNDERGRADUATE THESIS -->
    <section class="about-section split-section">
      <div class="section-heading">
        <p class="about-label">UNDERGRADUATE THESIS</p>
        <h2>Numerical &amp; computational mathematics</h2>
      </div>

      <div class="section-content">
        <h3>
          On the Determinant, Inverse, and Eigenvalues
          of Infinite Matrices
        </h3>

        <p>
          My undergraduate thesis studied matrix determinants,
          inverse constructions, eigenvalues, matrix logarithms,
          convergence, and series-expansion methods in the
          setting of infinite matrices.
          The work included numerical approaches to approximating
          matrix-related quantities.
        </p>

        <a class="text-link" href="/research/">
          See research experience ↗
        </a>
      </div>
    </section>

    <!-- SPEEDCUBING -->
    <section class="about-section split-section">
      <div class="section-heading">
        <p class="about-label">BEYOND RESEARCH</p>
        <h2>Speedcubing &amp; mathematical puzzles</h2>
      </div>

      <div class="section-content">
        <p>
          Speedcubing sparked my interest in the relationship
          between mathematical structure and computational
          problem-solving.
          I served as Instructor &amp; Head of the Cubing and
          Puzzle Wing at SUST Science Arena
          (February 2023–March 2024), organizing workshops
          and mentoring students.
        </p>

        <ul class="awards-list">
          {awards.map((award) => (
            <li>{award}</li>
          ))}
        </ul>

        <p>
          In 2023, I co-presented a contributory talk on
          the Rubik's Cube as an application of group theory.
        </p>

        <a class="text-link" href="/blog/">
          Explore mathematical writing ↗
        </a>
      </div>
    </section>

    <!-- ACADEMIC CV -->
    <section class="about-cv">
      <div>
        <p class="about-label">ACADEMIC PROFILE</p>
        <h2>Academic curriculum vitae</h2>
        <p>
          Education, research, professional experience,
          presentations, and technical skills.
        </p>
      </div>

      <a
        href="/Md_Arif_Hossain_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="cv-button"
      >
        View CV ↗
      </a>
    </section>

  </div>
</BaseLayout>

<style>
  /* ---------------------------------
     ABOUT PAGE: MINIMAL GLOBAL THEME
     --------------------------------- */

  .about-page {
    width: min(970px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 48px 0 70px;
    color: var(--color-text, #ececec);
    font-family: Arial, Helvetica, sans-serif;
  }

  .about-page * {
    box-sizing: border-box;
  }

  .about-page a {
    color: #39aad8;
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .about-page a:hover {
    color: #7fd9f2;
    text-decoration: underline;
  }

  /* ---------------------------------
     SMALL SECTION LABELS
     --------------------------------- */

  .about-label {
    margin: 0 0 12px;
    color: #39aad8;
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  /* ---------------------------------
     INTRODUCTION
     --------------------------------- */

  .about-hero {
    max-width: 850px;
    padding: 0 0 42px;
  }

  .about-hero h1 {
    margin: 0 0 19px;
    color: #ececec;
    font-size: clamp(2.2rem, 4vw, 2.8rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.04em;
  }

  .about-hero h1 em {
    font-style: normal;
    color: #39aad8;
  }

  .about-lead {
    max-width: 770px;
    margin: 0;
    color: #d0d0d0;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.7;
  }

  /* ---------------------------------
     SECTION SPACING
     --------------------------------- */

  .about-section {
    border-top: 1px solid #383838;
    padding: 38px 0 42px;
  }

  .split-section {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 38px;
    align-items: start;
  }

  .section-heading {
    min-width: 0;
  }

  .section-heading h2,
  .about-cv h2 {
    margin: 0;
    color: #ececec;
    font-size: clamp(1.5rem, 2.8vw, 1.85rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  /* ---------------------------------
     PARAGRAPHS AND TEXT
     --------------------------------- */

  .section-content {
    min-width: 0;
    max-width: 710px;
  }

  .section-content p {
    margin: 0 0 17px;
    color: #d0d0d0;
    font-size: 1rem;
    line-height: 1.72;
  }

  .section-content p:last-of-type {
    margin-bottom: 0;
  }

  .section-content strong {
    color: #ececec;
    font-weight: 650;
  }

  .section-content h3 {
    margin: 0 0 14px;
    color: #ececec;
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .text-link {
    display: inline-block;
    margin-top: 15px;
    font-size: 0.93rem;
    font-weight: 500;
  }

  /* ---------------------------------
     MILESTONES
     --------------------------------- */

  .milestones-section .section-heading {
    margin-bottom: 20px;
  }

  .timeline-list {
    border-top: 1px solid #383838;
  }

  .milestone {
    display: grid;
    grid-template-columns: 175px minmax(0, 1fr);
    gap: 30px;
    padding: 24px 0;
    border-bottom: 1px solid #383838;
  }

  .milestone:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .milestone-period {
    padding-top: 3px;
    color: #39aad8;
    font-size: 0.91rem;
    line-height: 1.5;
  }

  .milestone-content {
    min-width: 0;
    max-width: 720px;
  }

  .milestone-label {
    display: block;
    margin-bottom: 7px;
    color: #a6a6a6;
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .milestone-content h3 {
    margin: 0 0 5px;
    color: #ececec;
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .milestone-content p {
    margin: 0 0 10px;
    color: #d0d0d0;
    font-size: 0.96rem;
    line-height: 1.68;
  }

  .milestone-content .milestone-sub {
    color: #ababab;
    font-size: 0.91rem;
  }

  .milestone-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 0.91rem;
    line-height: 1.6;
  }

  .milestone-links span {
    color: #8f8f8f;
  }

  /* ---------------------------------
     AWARDS LIST
     --------------------------------- */

  .awards-list {
    margin: 8px 0 19px;
    padding-left: 21px;
    color: #d0d0d0;
    font-size: 0.96rem;
    line-height: 1.75;
    list-style: disc;
  }

  .awards-list li {
    padding-left: 3px;
    margin-bottom: 5px;
  }

  /* ---------------------------------
     ACADEMIC CV
     --------------------------------- */

  .about-cv {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 38px 0 0;
    border-top: 1px solid #383838;
  }

  .about-cv .about-label {
    margin-bottom: 8px;
  }

  .about-cv p:not(.about-label) {
    margin: 10px 0 0;
    color: #bcbcbc;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .cv-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 42px;
    padding: 10px 17px;
    border: 1px solid #39aad8;
    border-radius: 5px;
    font-size: 0.93rem;
    font-weight: 600;
    line-height: 1.4;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cv-button:hover {
    background: #39aad8;
    color: #1b1b1b !important;
    text-decoration: none !important;
  }

  /* ---------------------------------
     TABLET
     --------------------------------- */

  @media (max-width: 780px) {
    .about-page {
      padding-top: 38px;
    }

    .split-section {
      grid-template-columns: 165px minmax(0, 1fr);
      gap: 25px;
    }

    .milestone {
      grid-template-columns: 140px minmax(0, 1fr);
      gap: 20px;
    }
  }

  /* ---------------------------------
     MOBILE
     --------------------------------- */

  @media (max-width: 620px) {
    .about-page {
      width: calc(100% - 2rem);
      padding: 32px 0 50px;
    }

    .about-hero {
      padding-bottom: 32px;
    }

    .about-hero h1 {
      font-size: clamp(2rem, 7vw, 2.45rem);
    }

    .about-section {
      padding: 29px 0 33px;
    }

    .split-section {
      grid-template-columns: 1fr;
      gap: 19px;
    }

    .milestones-section .section-heading {
      margin-bottom: 18px;
    }

    .milestone {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 21px 0;
    }

    .milestone-period {
      padding-top: 0;
    }

    .about-cv {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      padding-top: 29px;
    }

    .section-content p,
    .about-lead {
      font-size: 0.96rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-button {
      transition: none;
    }
  }
</style>
