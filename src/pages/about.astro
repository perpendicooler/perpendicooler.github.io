---
import BaseLayout from "../layouts/BaseLayout.astro";

const indesoreWebsite = "https://www.indesore.com/";
const indesoreLinkedIn = "https://www.linkedin.com/company/indesoregroup/";

const timeline = [
  {
    period: "2019–2024",
    label: "Education",
    title: "B.Sc. in Mathematics",
    sub: "Shahjalal University of Science and Technology (SUST), Sylhet",
    copy: "CGPA: 3.28/4.00. Mathematical training in algebra, numerical methods, mathematical programming, and analytical problem-solving.",
  },
  {
    period: "Sep 2023 – May 2024",
    label: "Research",
    title: "Research Student · SUST Research Center",
    sub: "Project investigator: Dr. Mohammad Salah Uddin",
    copy: "Investigated matrix methods for combinatorial aspects of posets and lattices, with MATLAB-based computational exploration. Project No. PS/2023/1/19.",
  },
  {
    period: "Jun 2024 – Present",
    label: "Industry",
    title: "Business Intelligence Analyst · INDESORE Group",
    sub: "Dhaka, Bangladesh",
    copy: "Develop production-capacity, efficiency, machine-utilization, SMV-prediction, downtime, and resource-allocation analytics for manufacturing operations.",
  },
];

const awards = [
  "Champion — Mechnovation 2022, SUST",
  "Champion — Mechnovation 2019, SUST",
  "Top 20 in Bangladesh — Knights Cubing Open 2019 (WCA)",
];

// Lightweight icon grid; no JavaScript library or other site file needed.
// Brand icons are loaded from public SVG icon libraries.
const devicon = (slug: string) =>
  `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${slug}/${slug}-original.svg`;

interface SkillIcon {
  name: string;
  src?: string;
  symbol?: string;
  mono?: boolean;
}

const skillGroups: { title: string; icons: SkillIcon[] }[] = [
  {
    title: "Optimization & Mathematical Modeling",
    icons: [
      {
        name: "Gurobi",
        src: "https://raw.githubusercontent.com/simple-icons/simple-icons/develop/icons/gurobi.svg",
        mono: true,
      },
      { name: "PuLP", symbol: "LP" },
      { name: "NetworkX", src: devicon("networkx") },
      { name: "Linear & Mixed-Integer Programming", symbol: "Σ" },
    ],
  },
  {
    title: "Programming & Scientific Computing",
    icons: [
      { name: "Python", src: devicon("python") },
      { name: "pandas", src: devicon("pandas") },
      { name: "NumPy", src: devicon("numpy") },
      { name: "SciPy", symbol: "Sci" },
      { name: "SQL", symbol: "SQL" },
      { name: "MATLAB", src: devicon("matlab") },
      { name: "R (Basic)", src: devicon("r") },
    ],
  },
  {
    title: "Machine Learning & Statistical Modeling",
    icons: [
      { name: "scikit-learn", src: devicon("scikitlearn") },
      { name: "XGBoost", symbol: "XGB" },
      { name: "Matplotlib", src: devicon("matplotlib") },
      { name: "Seaborn", symbol: "SB" },
    ],
  },
  {
    title: "Business Intelligence & Visualization",
    icons: [
      { name: "Tableau", symbol: "T" },
      { name: "Power BI", symbol: "BI" },
      { name: "Advanced Excel", symbol: "XLS" },
      { name: "DAX", symbol: "DAX" },
    ],
  },
  {
    title: "Research & Development Tools",
    icons: [
      { name: "Jupyter Notebook", src: devicon("jupyter") },
      { name: "Streamlit", src: devicon("streamlit") },
      { name: "Git", src: devicon("git") },
      { name: "GitHub", src: devicon("github"), mono: true },
      { name: "LaTeX", src: devicon("latex"), mono: true },
      { name: "HTML5", src: devicon("html5") },
      { name: "CSS3", src: devicon("css3") },
    ],
  },
];
---

<BaseLayout
  title="About | Md Arif Hossain"
  description="Academic background, combinatorial research, industrial analytics experience, and mathematical interests of Md Arif Hossain."
>
  <div class="container page-shell">

    <!-- INTRODUCTION -->
    <header class="page-header">
      <p class="eyebrow">BACKGROUND / JOURNEY</p>

      <h1>
        Curiosity about mathematics.
        <em>Motivation to apply it.</em>
      </h1>

      <p class="page-lead">
        I began in pure and computational mathematics and found
        a new set of questions in industrial systems: how can
        models allocate scarce resources, anticipate uncertainty,
        and help organizations make better decisions?
      </p>
    </header>


    <!-- ABOUT ME -->
    <section class="content-section two-col">
      <div>
        <p class="eyebrow">AT A GLANCE</p>
        <h2>About me</h2>
      </div>
    
      <div class="prose-block">
    
        <p style="margin: 0 0 20px;">
          I am <strong>Md Arif Hossain</strong>, a Mathematics
          graduate from{" "}
          <a
            href="https://www.sust.edu/"
            target="_blank"
            rel="noopener noreferrer"
          >Shahjalal University of Science and Technology (SUST)</a>,
          Bangladesh, and a Business Intelligence Analyst at{" "}
          <a
            href={indesoreWebsite}
            target="_blank"
            rel="noopener noreferrer"
          ><strong>INDESORE Group</strong></a>.
          You can also find the organization on{" "}
          <a
            href={indesoreLinkedIn}
            target="_blank"
            rel="noopener noreferrer"
          >LinkedIn ↗</a>.
        </p>
    
        <p style="margin: 0 0 20px;">
          At SUST, I worked on computational methods for{" "}
          <strong>partially ordered sets and lattices</strong>{" "}
          under the guidance of{" "}
          <a
            href="https://www.sust.edu/departments/mat/faculty/salahuddin-mat%40sust.edu"
            target="_blank"
            rel="noopener noreferrer"
          ><strong>Dr. Mohammad Salah Uddin</strong></a>.
          I also completed an undergraduate thesis on determinants,
          inverses, and eigenvalues of infinite matrices.
          Those experiences helped shape my interest in rigorous
          mathematical analysis and computation.
        </p>
    
        <p style="margin: 0 0 20px;">
          In professional practice, I have worked with production
          planning, Standard Minute Value estimation, capacity
          feasibility, efficiency, and operational decision support.
          Seeing the constraints and uncertainty of real manufacturing
          operations has deepened my interest in{" "}
          <strong>operations research, mixed-integer programming,
          and large-scale optimization</strong>.
        </p>
    
        <p style="margin: 0;">
          I am interested in pursuing PhD research that connects
          mathematical theory, algorithms, and practical
          decision-making in manufacturing and supply-chain systems.
        </p>
    
      </div>
    </section>


    <!-- EDUCATION, RESEARCH AND EXPERIENCE -->
    <section class="content-section">
      <p class="eyebrow">EDUCATION · RESEARCH · EXPERIENCE</p>

      <h2>Selected milestones</h2>

      <div class="timeline">
        {timeline.map((t) => (
          <article class="timeline-item">
            <p class="timeline-year">{t.period}</p>

            <div>
              <span class="mini-label">{t.label}</span>

              <h3>{t.title}</h3>

              <p class="muted">{t.sub}</p>

              <p>{t.copy}</p>

              {t.label === "Research" && (
                <p>
                  <a
                    class="inline-link"
                    href="https://www.sust.edu/departments/mat/faculty/salahuddin-mat%40sust.edu"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Research supervisor's SUST profile ↗
                  </a>
                </p>
              )}

              {t.label === "Industry" && (
                <p class="organization-links">
                  <a
                    class="inline-link"
                    href={indesoreWebsite}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Official Website ↗
                  </a>

                  <span class="link-separator"> · </span>

                  <a
                    class="inline-link"
                    href={indesoreLinkedIn}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    INDESORE LinkedIn ↗
                  </a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- UNDERGRADUATE THESIS -->
    <section class="content-section two-col">
      <div>
        <p class="eyebrow">UNDERGRADUATE THESIS</p>

        <h2>Numerical &amp; computational mathematics</h2>
      </div>

      <div class="prose-block">
        <h3>
          On the Determinant, Inverse, and Eigenvalues of
          Infinite Matrices
        </h3>

        <p>
          My undergraduate thesis studied matrix determinants,
          inverse constructions, eigenvalues, matrix logarithms,
          convergence, and series-expansion methods in the
          setting of infinite matrices.
          The work included numerical approaches to
          approximating matrix-related quantities.
        </p>

        <a class="inline-link" href="/research/">
          See research experience ↗
        </a>
      </div>
    </section>

    <!-- BEYOND RESEARCH -->
    <section class="content-section two-col">
      <div>
        <p class="eyebrow">BEYOND RESEARCH</p>

        <h2>Speedcubing &amp; mathematical puzzles</h2>
      </div>

      <div class="prose-block">
        <p>
          Speedcubing sparked my interest in the relationship
          between mathematical structure and computational
          problem-solving.
          I served as Instructor &amp; Head of the Cubing
          and Puzzle Wing at SUST Science Arena
          (February 2023–March 2024), organizing workshops
          and mentoring students.
        </p>

        <ul>
          {awards.map((award) => (
            <li>{award}</li>
          ))}
        </ul>

        <p>
          In 2023, I co-presented a contributory talk on
          the Rubik's Cube as an application of group theory.
        </p>

        <a class="inline-link" href="/blog/">
          Explore mathematical writing ↗
        </a>
      </div>
    </section>


    <!-- TECHNICAL SKILLS -->
    <section
      id="technical-skills"
      class="content-section two-col"
      aria-labelledby="technical-skills-heading"
    >
      <div>
        <p class="eyebrow">TECHNICAL BACKGROUND</p>
        <h2 id="technical-skills-heading">Technical skills</h2>
      </div>
    
      <div class="tech-icon-groups">
        {skillGroups.map((group) => (
          <div class="tech-icon-group">
            <h3>{group.title}</h3>
    
            <ul class="tech-icon-grid">
              {group.icons.map((skill) => (
                <li>
                  <span
                    class:list={[
                      "tech-tile",
                      { "tech-mono": skill.mono },
                    ]}
                    role="img"
                    aria-label={skill.name}
                    data-name={skill.name}
                    tabindex="0"
                  >
                    {skill.src ? (
                      <img
                        src={skill.src}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="tech-symbol" aria-hidden="true">
                        {skill.symbol}
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
    
        <a class="inline-link" href="/projects/">
          Explore applied projects ↗
        </a>
      </div>
    </section>


    <!-- ACADEMIC CV -->
    <section class="cta-band">
      <div>
        <p class="eyebrow">PROFILE</p>

        <h2>Read my complete academic CV.</h2>

        <p>
          Experience, projects, talks, skills, and achievements.
        </p>
      </div>

      <a
        class="btn btn-primary"
        href="/Md_Arif_Hossain_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        Download CV ↗
      </a>
    </section>

  </div>
</BaseLayout>

<style>
  .organization-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .link-separator {
    color: var(--color-text-subtle);
  }

  .organization-links a {
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }

  .organization-links a:hover {
    text-decoration: underline;
  }

/* MINIMAL TECHNICAL SKILLS ICON GRID */

.tech-icon-groups {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 25px;
}

.tech-icon-group h3 {
  margin: 0 0 12px;
  color: var(--color-text);
  font-size: 0.94rem;
  font-weight: 600;
  line-height: 1.45;
}

.tech-icon-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(58px, 1fr));
  gap: 10px;
  padding: 0;
  margin: 0;
  list-style: none;
}

.tech-tile {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60px;
  width: 100%;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  background: var(--color-surface);
  color: var(--color-text);
  cursor: default;
  transition: border-color 0.2s, background 0.2s;
}

.tech-tile:hover,
.tech-tile:focus-visible {
  border-color: var(--color-accent);
  background: var(--color-surface-raised);
}

.tech-tile:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

.tech-tile img {
  display: block;
  width: 34px;
  height: 34px;
  object-fit: contain;
}

.tech-symbol {
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--color-accent);
}

/* Keep monochrome brand icons visible in dark mode */
:global(html:not([data-theme="light"])) .tech-mono img {
  filter: invert(1);
}

/* Icon name tooltip */
.tech-tile::after {
  content: attr(data-name);
  position: absolute;
  left: 50%;
  bottom: calc(100% + 7px);
  transform: translateX(-50%);
  padding: 5px 9px;
  border: 1px solid var(--color-border);
  border-radius: 5px;
  background: var(--color-surface-raised);
  color: var(--color-text);
  font-size: 0.75rem;
  font-weight: 400;
  line-height: 1.3;
  white-space: nowrap;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  z-index: 5;
}

.tech-tile:hover::after,
.tech-tile:focus-visible::after {
  opacity: 1;
  visibility: visible;
}

.tech-icon-groups > .inline-link {
  align-self: flex-start;
  font-size: 0.92rem;
  margin-top: 2px;
}

@media (max-width: 650px) {
  .tech-icon-grid {
    grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
    gap: 8px;
  }

  .tech-tile {
    height: 54px;
  }

  .tech-tile img {
    width: 30px;
    height: 30px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .tech-tile {
    transition: none;
  }
}


</style>
