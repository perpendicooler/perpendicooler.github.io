---
import BaseLayout from '../layouts/BaseLayout.astro';

const researchCertificate = '/Arif_SUST_Research_Experience_Certificate.pdf';
const thesisReport = '/Arif_Infinite_Matrices_Undergraduate_Thesis.pdf';
const supervisorProfile = 'https://www.sust.edu/departments/mat/faculty/salahuddin-mat%40sust.edu';

const interests = [
  { n: '01', title: 'Operations Research & Mixed-Integer Programming', copy: 'Modeling allocation, facility location, routing, and constrained decisions using mathematical optimization.' },
  { n: '02', title: 'Combinatorial & Computational Mathematics', copy: 'Partially ordered sets, lattices, combinatorial structures, and computational approaches to mathematical questions.' },
  { n: '03', title: 'Supply Chain & Manufacturing Systems', copy: 'Capacity planning, uncertainty and scenarios, efficiency, and bottleneck-driven decision support.' },
  { n: '04', title: 'Machine Learning for Decision Support', copy: 'Predictive analytics and model evaluation in service of transparent, operationally useful decisions.' },
];

const outputs = [
  {
    title: 'Rubik’s Cube – An Application of Group Theory',
    authors: 'Md Arif Hossain; Chandrani Nag',
    venue: 'International Conference on Science, Technology, Engineering, Mathematics, and Education',
    status: 'Contributory talk · 2023',
    url: "https://github.com/perpendicooler/Rubik-s-Cube-An-application-of-group-theory/blob/main/Rubik's%20Cube%20presentation%20certificate.pdf",
  },
  {
    title: 'The Alternative Form of the Order of an Element in a Group Under Addition Modulo',
    authors: 'Md Arif Hossain; Chandrani Nag',
    venue: 'International Conference on Science, Technology, Engineering, Mathematics, and Education',
    status: 'Contributory talk · 2023',
    url: 'https://github.com/perpendicooler/An-different-approach-to-solve-addition-modulo-in-group-theory/blob/main/Group%20theory%20certificate%20of%20presentation.pdf',
  },
  {
    title: 'Fine-Grained Classification of Depression, Loneliness, and Fear in Bangla Social Media Text',
    authors: 'Sadia Ahmed; Md Arif Hossain; Md Anisujjaman; Mohammed Minhaj Uddin; Md. Shafiul Alam Forhad',
    venue: '29th International Conference on Computer and Information Technology (ICCIT 2026)',
    status: 'Submitted manuscript · not a published article',
    url: '',
  },
];
---

<BaseLayout
  title="Research | Md Arif Hossain"
  description="Research interests, SUST Research Center experience, undergraduate mathematics project, and documented scholarly contributions of Md Arif Hossain."
>
  <div class="container page-shell">
    <header class="page-header">
      <p class="eyebrow">RESEARCH / INTERESTS &amp; CONTRIBUTIONS</p>
      <h1>Rigorous models for <em>complex decisions.</em></h1>
      <p class="page-lead">
        My academic direction combines the structure of discrete mathematics,
        the expressiveness of optimization models, and the realities of decision-making
        in industrial systems.
      </p>
    </header>

    <section class="content-section">
      <div class="section-intro">
        <div>
          <p class="eyebrow">01 / AREAS OF INTEREST</p>
          <h2>Research directions</h2>
        </div>
      </div>
      <div class="research-grid">
        {interests.map((interest) => (
          <article class="research-card">
            <span class="focus-number">{interest.n}</span>
            <h3>{interest.title}</h3>
            <p>{interest.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- SUST RESEARCH APPOINTMENT -->
    <section class="content-section research-case-section" aria-labelledby="appointment-title">
      <div class="case-heading">
        <p class="eyebrow">02 / RESEARCH APPOINTMENT</p>
        <h2 id="appointment-title">Matrix methods for posets &amp; lattices</h2>
      </div>

      <article class="research-showcase">
        <div class="showcase-side">
          <span class="side-index" aria-hidden="true">02</span>
          <p class="side-label">RESEARCH STUDENT</p>
          <p class="side-org">SUST Research Center</p>
          <p class="side-date">September 2023 — May 2024</p>
          <div class="side-divider" aria-hidden="true"></div>
          <p class="side-id-label">PROJECT REFERENCE</p>
          <p class="side-id">PS/2023/1/19</p>
        </div>

        <div class="showcase-main">
          <p class="showcase-kicker">Funded academic research · Department of Mathematics, SUST</p>
          <h3>Implementations of the Matrix Methods for Combinatorial Aspects of Posets and Lattices</h3>
          <p class="showcase-description">
            As a research student, I developed and implemented enumeration algorithms
            to generate, organize, and visualize numerical research data related to
            partially ordered sets and lattices.
          </p>
          <div class="showcase-facts">
            <div>
              <span>Supervision</span>
              <a href={supervisorProfile} target="_blank" rel="noopener noreferrer">Dr. Mohammad Salah Uddin ↗</a>
            </div>
            <div>
              <span>Research tools</span>
              <strong>Python · R · MATLAB</strong>
            </div>
          </div>
          <div class="showcase-actions">
            <a class="showcase-action showcase-action-primary" href={researchCertificate} target="_blank" rel="noopener noreferrer">View research certificate (PDF) <span aria-hidden="true">↗</span></a>
            <a class="showcase-action" href="/projects/posets-lattices/">Research summary <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </article>
    </section>

    <!-- UNDERGRADUATE MATHEMATICS PROJECT -->
    <section class="content-section research-case-section" aria-labelledby="undergraduate-title">
      <div class="case-heading">
        <p class="eyebrow">03 / UNDERGRADUATE MATHEMATICS PROJECT</p>
        <h2 id="undergraduate-title">Infinite matrices &amp; numerical methods</h2>
      </div>

      <article class="research-showcase">
        <div class="showcase-side">
          <span class="side-index" aria-hidden="true">03</span>
          <p class="side-label">B.SC. (HONORS) MATHEMATICS</p>
          <p class="side-org">Shahjalal University of Science and Technology</p>
          <p class="side-date">22 February 2024</p>
          <div class="side-divider" aria-hidden="true"></div>
          <p class="side-id-label">COURSE</p>
          <p class="side-id">MAT 433</p>
        </div>

        <div class="showcase-main">
          <p class="showcase-kicker">Collaborative undergraduate mathematics project</p>
          <h3>On the Determinant, Inverse, and Eigenvalues of Infinite Matrices</h3>
          <p class="showcase-description">
            We studied determinants, inverses, eigenvalues, matrix logarithms,
            and convergence, including computational algorithms and numerical
            examples based on series expansions and iterative approximation.
          </p>
          <div class="showcase-facts">
            <div>
              <span>Authors</span>
              <strong>Md Arif Hossain, Iftekhar Al Mahmud, Rafiur Rahman, and Durjoy Das</strong>
            </div>
            <div>
              <span>Supervisor</span>
              <a href={supervisorProfile} target="_blank" rel="noopener noreferrer">Dr. Mohammad Salah Uddin ↗</a>
            </div>
          </div>
          <div class="showcase-actions">
            <a class="showcase-action showcase-action-primary" href={thesisReport} target="_blank" rel="noopener noreferrer">Read full project report (PDF) <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </article>
    </section>

    <section class="content-section">
      <p class="eyebrow">04 / PRESENTATIONS &amp; SCHOLARLY WORK</p>
      <h2>Documented research contributions</h2>
      <p class="section-note">
        Conference talks are distinguished from journal publications.
        The ICCIT manuscript is listed as submitted, not as accepted or published.
      </p>
      <div class="paper-list">
        {outputs.map((output, i) => (
          <article class="paper-item">
            <span class="paper-number">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="mini-label">{output.status}</p>
              <h3>{output.title}</h3>
              <p>{output.authors}</p>
              <p class="muted">{output.venue}</p>
              {output.url && (
                <a class="inline-link" href={output.url} target="_blank" rel="noopener noreferrer">Presentation certificate ↗</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="cta-band">
      <div>
        <p class="eyebrow">SELECTED WORK</p>
        <h2>Research meets implementation.</h2>
        <p>Explore mathematical programming, numerical research, and industrial decision analytics.</p>
      </div>
      <a class="btn btn-primary" href="/projects/">View projects ↗</a>
    </section>
  </div>
</BaseLayout>

<style>
  /* Editorial presentation for both academic research records */
  .research-case-section {
    padding-block: clamp(3rem, 5vw, 4.6rem);
  }

  .case-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 2rem;
    row-gap: .65rem;
    margin-bottom: 1.55rem;
  }

  .case-heading .eyebrow {
    flex: 0 0 100%;
    margin: 0;
  }

  .case-heading h2 {
    max-width: 790px;
    margin: 0;
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    line-height: 1.25;
    letter-spacing: -.035em;
    font-weight: 450;
  }

  .research-showcase {
    display: grid;
    grid-template-columns: minmax(205px, 0.33fr) minmax(0, 0.67fr);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .showcase-side {
    min-width: 0;
    padding: clamp(1.55rem, 3vw, 2.25rem);
    background: linear-gradient(150deg, rgb(57 170 216 / 11%), transparent 78%);
    border-right: 1px solid var(--color-border);
  }

  .side-index {
    display: block;
    margin: 0 0 2.3rem;
    color: var(--color-accent);
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: -.04em;
    line-height: 1;
  }

  .side-label,
  .side-id-label {
    margin: 0 0 .65rem;
    color: var(--color-accent);
    font-size: .7rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    letter-spacing: .11em;
  }

  .side-org {
    margin: 0 0 .75rem;
    color: var(--color-text);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .side-date,
  .side-id {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .91rem;
    line-height: 1.65;
  }

  .side-id { color: var(--color-text); font-weight: 600; }
  .side-divider { height: 1px; width: 100%; background: var(--color-border); margin: 1.55rem 0 1.25rem; }

  .showcase-main {
    min-width: 0;
    padding: clamp(1.7rem, 3.5vw, 2.8rem);
  }

  .showcase-kicker {
    margin: 0 0 .9rem;
    color: var(--color-accent);
    font-size: .74rem;
    letter-spacing: .06em;
    line-height: 1.6;
  }

  .showcase-main h3 {
    margin: 0 0 1.1rem;
    color: var(--color-text);
    max-width: 720px;
    font-size: clamp(1.32rem, 2.2vw, 1.7rem);
    font-weight: 540;
    letter-spacing: -.027em;
    line-height: 1.38;
  }

  .showcase-description {
    max-width: 700px;
    margin: 0 0 1.65rem;
    color: var(--color-text-muted);
    font-size: .99rem;
    line-height: 1.85;
  }

  .showcase-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.4rem;
    margin-bottom: 1.65rem;
  }

  .showcase-facts > div { min-width: 0; }
  .showcase-facts span {
    display: block;
    margin-bottom: .45rem;
    color: var(--color-text-subtle);
    font-size: .76rem;
    line-height: 1.4;
  }
  .showcase-facts a,
  .showcase-facts strong {
    color: var(--color-text);
    text-decoration: none;
    font-size: .91rem;
    font-weight: 550;
    line-height: 1.65;
  }
  .showcase-facts a:hover { color: var(--color-accent); text-decoration: underline; }

  .showcase-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; }
  .showcase-action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: .7rem;
    min-height: 42px;
    padding: .55rem .9rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-accent);
    font-size: .85rem;
    font-weight: 600;
    line-height: 1.4;
    transition: border-color .2s ease, background .2s ease;
  }
  .showcase-action-primary { background: var(--color-surface-raised); }
  .showcase-action:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-raised);
    text-decoration: none;
  }
  .showcase-action:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

  @media (max-width: 740px) {
    .research-showcase { grid-template-columns: 1fr; }
    .showcase-side { border-right: none; border-bottom: 1px solid var(--color-border); }
    .side-index { margin-bottom: 1.15rem; }
    .showcase-facts { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .showcase-action { transition: none; }
  }
</style>
