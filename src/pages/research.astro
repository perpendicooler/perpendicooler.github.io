---
import BaseLayout from '../layouts/BaseLayout.astro';

const researchCertificate = '/Arif_SUST_Research_Experience_Certificate.pdf';
const thesisReport = '/Arif_Infinite_Matrices_Undergraduate_Thesis.pdf';
const supervisorProfile = 'https://www.sust.edu/departments/mat/faculty/salahuddin-mat%40sust.edu';

const interests = [
  { n: '01', title: 'Operations Research & Mixed-Integer Programming', copy: 'Modeling allocation, facility location, routing, and constrained decisions using mathematical optimization.' },
  { n: '02', title: 'Combinatorial & Computational Mathematics', copy: 'Partially ordered sets, lattices, combinatorial structures, and computational approaches to mathematical questions.' },
  { n: '03', title: 'Supply Chain & Manufacturing Systems', copy: 'Capacity planning, uncertainty and scenarios, efficiency, and bottleneck-driven decision support.' },
  { n: '04', title: 'Machine Learning for Decision Support', copy: 'Predictive analytics and model evaluation in service of transparent, operationally useful decisions.' },
];

const outputs = [
  {
    title: 'Rubik’s Cube – An Application of Group Theory',
    authors: 'Md Arif Hossain; Chandrani Nag',
    venue: 'International Conference on Science, Technology, Engineering, Mathematics, and Education',
    status: 'Contributory talk · 2023',
    url: "https://github.com/perpendicooler/Rubik-s-Cube-An-application-of-group-theory/blob/main/Rubik's%20Cube%20presentation%20certificate.pdf",
  },
  {
    title: 'The Alternative Form of the Order of an Element in a Group Under Addition Modulo',
    authors: 'Md Arif Hossain; Chandrani Nag',
    venue: 'International Conference on Science, Technology, Engineering, Mathematics, and Education',
    status: 'Contributory talk · 2023',
    url: 'https://github.com/perpendicooler/An-different-approach-to-solve-addition-modulo-in-group-theory/blob/main/Group%20theory%20certificate%20of%20presentation.pdf',
  },
  {
    title: 'Fine-Grained Classification of Depression, Loneliness, and Fear in Bangla Social Media Text',
    authors: 'Sadia Ahmed; Md Arif Hossain; Md Anisujjaman; Mohammed Minhaj Uddin; Md. Shafiul Alam Forhad',
    venue: '29th International Conference on Computer and Information Technology (ICCIT 2026)',
    status: 'Submitted manuscript · not a published article',
    url: '',
  },
];
---

<BaseLayout
  title="Research | Md Arif Hossain"
  description="Research interests, SUST Research Center experience, undergraduate mathematics project, and documented scholarly contributions of Md Arif Hossain."
>
  <div class="container page-shell">
    <header class="page-header">
      <p class="eyebrow">RESEARCH / INTERESTS &amp; CONTRIBUTIONS</p>
      <h1>Rigorous models for <em>complex decisions.</em></h1>
      <p class="page-lead">
        My academic direction combines the structure of discrete mathematics,
        the expressiveness of optimization models, and the realities of decision-making
        in industrial systems.
      </p>
    </header>

    <section class="content-section">
      <div class="section-intro">
        <div>
          <p class="eyebrow">01 / AREAS OF INTEREST</p>
          <h2>Research directions</h2>
        </div>
      </div>
      <div class="research-grid">
        {interests.map((interest) => (
          <article class="research-card">
            <span class="focus-number">{interest.n}</span>
            <h3>{interest.title}</h3>
            <p>{interest.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- SUST RESEARCH APPOINTMENT -->
    <section class="content-section two-col research-entry" aria-labelledby="appointment-title">
      <div class="research-side">
        <p class="eyebrow">02 / RESEARCH APPOINTMENT</p>
        <h2 id="appointment-title">Matrix methods for posets &amp; lattices</h2>
      </div>

      <div class="prose-block research-copy">
        <p class="research-meta">SUST Research Center · September 2023–May 2024</p>
        <h3 class="research-title">Implementations of the Matrix Methods for Combinatorial Aspects of Posets and Lattices</h3>
        <p>
          I worked as a research student in the Department of Mathematics at
          Shahjalal University of Science and Technology, developing enumeration
          algorithms and organizing and visualizing numerical research data
          related to partially ordered sets and lattices.
        </p>
        <p>
          Supervised by
          <a href={supervisorProfile} target="_blank" rel="noopener noreferrer">Dr. Mohammad Salah Uddin</a>.
          My computational work used Python, R, and MATLAB.
        </p>
        <p class="research-detail">Project PS/2023/1/19 · Funded by SUST Research Center</p>
        <div class="research-links">
          <a class="inline-link" href={researchCertificate} target="_blank" rel="noopener noreferrer">Research experience certificate (PDF) ↗</a>
          <a class="inline-link" href="/projects/posets-lattices/">Research summary ↗</a>
        </div>
      </div>
    </section>

    <!-- UNDERGRADUATE MATHEMATICS PROJECT -->
    <section class="content-section two-col research-entry" aria-labelledby="undergraduate-title">
      <div class="research-side">
        <p class="eyebrow">03 / UNDERGRADUATE PROJECT</p>
        <h2 id="undergraduate-title">Infinite matrices &amp; numerical methods</h2>
      </div>

      <div class="prose-block research-copy">
        <p class="research-meta">B.Sc. Mathematics · MAT 433 · 22 February 2024</p>
        <h3 class="research-title">On the Determinant, Inverse, and Eigenvalues of Infinite Matrices</h3>
        <p>
          This collaborative undergraduate mathematics project examined
          determinants, matrix inverses, eigenvalues, matrix logarithms, and
          convergence, with numerical approximations using series expansions
          and iterative algorithms.
        </p>
        <p class="research-detail">
          <strong>Authors:</strong> Md Arif Hossain, Iftekhar Al Mahmud,
          Rafiur Rahman, and Durjoy Das.
        </p>
        <p class="research-detail">
          <strong>Supervisor:</strong>
          <a href={supervisorProfile} target="_blank" rel="noopener noreferrer">Dr. Mohammad Salah Uddin</a>.
        </p>
        <div class="research-links">
          <a class="inline-link" href={thesisReport} target="_blank" rel="noopener noreferrer">Read the full undergraduate project (PDF) ↗</a>
        </div>
      </div>
    </section>

    <section class="content-section">
      <p class="eyebrow">04 / PRESENTATIONS &amp; SCHOLARLY WORK</p>
      <h2>Documented research contributions</h2>
      <p class="section-note">
        Conference talks are distinguished from journal publications.
        The ICCIT manuscript is listed as submitted, not as accepted or published.
      </p>
      <div class="paper-list">
        {outputs.map((output, i) => (
          <article class="paper-item">
            <span class="paper-number">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="mini-label">{output.status}</p>
              <h3>{output.title}</h3>
              <p>{output.authors}</p>
              <p class="muted">{output.venue}</p>
              {output.url && (
                <a class="inline-link" href={output.url} target="_blank" rel="noopener noreferrer">Presentation certificate ↗</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="cta-band">
      <div>
        <p class="eyebrow">SELECTED WORK</p>
        <h2>Research meets implementation.</h2>
        <p>Explore mathematical programming, numerical research, and industrial decision analytics.</p>
      </div>
      <a class="btn btn-primary" href="/projects/">View projects ↗</a>
    </section>
  </div>
</BaseLayout>

<style>
  /* Same open, two-column editorial layout as the rest of the site. */
  .research-entry {
    align-items: start;
  }

  .research-side,
  .research-copy {
    min-width: 0;
  }

  .research-entry .research-side h2 {
    max-width: 335px;
    font-size: clamp(1.65rem, 2.7vw, 2.15rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.3;
  }

  .research-copy {
    max-width: 760px;
    font-size: 1rem;
    line-height: 1.75;
  }

  .research-copy .research-meta {
    margin: 0 0 12px;
    color: var(--color-accent);
    font-family: var(--font-mono, monospace);
    font-size: 0.77rem;
    letter-spacing: 0.025em;
    line-height: 1.6;
  }

  .research-copy .research-title {
    margin: 0 0 18px;
    color: var(--color-text);
    font-size: clamp(1.12rem, 1.7vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.45;
  }

  .research-copy p {
    margin: 0 0 16px;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .research-copy .research-detail {
    font-size: 0.92rem;
    line-height: 1.65;
    margin-bottom: 10px;
  }

  .research-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 26px;
    padding-top: 10px;
  }

  .research-links a {
    font-size: 0.91rem;
    line-height: 1.6;
  }

  @media (max-width: 780px) {
    .research-entry {
      gap: 18px;
    }

    .research-entry .research-side h2 {
      max-width: 100%;
    }
  }
</style>
