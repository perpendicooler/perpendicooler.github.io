---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugifyTag } from '../../utils/tags';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// These illustrations already exist in public/images/blog/.
// Only update the paths if you rename or replace those files.
const illustrations: Record<string, { src: string; alt: string }> = {
  'operations-research-bangladesh-manufacturing': {
    src: '/images/blog/manufacturing-analytics-flow.svg',
    alt: 'Diagram of factory data flowing toward manufacturing decisions',
  },
  'tic-tac-toe-extensive-form-game-theory': {
    src: '/images/blog/tictactoe-game-tree.svg',
    alt: 'Illustration of a Tic-Tac-Toe game tree',
  },
  'minimax-alpha-beta-pruning-python': {
    src: '/images/blog/minimax-alpha-beta.svg',
    alt: 'Minimax game tree illustrating alpha-beta pruning',
  },
  'tictactoe-symmetry-burnsides-lemma': {
    src: '/images/blog/tictactoe-symmetry.svg',
    alt: 'Geometric symmetry transformations of a Tic-Tac-Toe board',
  },
  'rubiks-cube-group-theory-combinatorics': {
    src: '/images/blog/Rubiks_Cube.svg',
    alt: 'Isometric Rubik’s Cube representing permutations and group theory',
  },
};
---

<BaseLayout
  title="Writing | Md Arif Hossain"
  description="Academic essays on group theory, combinatorics, minimax, game theory, and manufacturing operations research."
>
  <div class="container page-shell">
    <header class="page-header">
      <p class="eyebrow">WRITING / NOTES &amp; ESSAYS</p>
      <h1>Mathematics, algorithms, <em>and the world they model.</em></h1>
      <p class="page-lead">
        Expository notes and technical essays on combinatorics, group theory,
        adversarial algorithms, and data-driven operational planning.
      </p>
    </header>

    <section class="content-section" aria-label="Articles">
      <div class="writing-list">
        {posts.map((post) => {
          const href = `/blog/${post.id}/`;
          const artwork = illustrations[post.id];

          return (
            <article class="writing-entry illustrated-entry">
              <div class="entry-copy">
                <p class="mini-label">
                  {post.data.pubDate.toLocaleDateString('en-GB', {
                    day: 'numeric', month: 'long', year: 'numeric'
                  })}
                </p>
                <h2><a href={href}>{post.data.title}</a></h2>
                <p class="entry-description">{post.data.description}</p>
                <div class="tag-row" aria-label="Topics">
                  {post.data.tags.map((tag) => (
                    <a class="tag-pill" href={`/blog/tags/${slugifyTag(tag)}/`}>{tag}</a>
                  ))}
                </div>
              </div>

              {artwork && (
                <a class="entry-visual" href={href} aria-label={`Read ${post.data.title}`}>
                  <img
                    src={artwork.src}
                    alt={artwork.alt}
                    loading="lazy"
                    decoding="async"
                    width="1200"
                    height="640"
                  />
                  <span class="visual-arrow" aria-hidden="true">↗</span>
                </a>
              )}
            </article>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Applied only to the Writing page; existing site CSS stays unchanged. */
  .illustrated-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 245px;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: 2.1rem 0.3rem;
  }

  .entry-copy {
    min-width: 0;
  }

  .entry-copy h2 {
    margin: 0.3rem 0 0.55rem;
    font-size: clamp(1.22rem, 2.3vw, 1.75rem);
    line-height: 1.3;
    font-weight: 400;
  }

  .entry-copy h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .entry-copy h2 a:hover {
    color: var(--color-accent);
  }

  .entry-description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .entry-copy .tag-row {
    margin-bottom: 0;
  }

  .entry-visual {
    position: relative;
    display: block;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    isolation: isolate;
    box-shadow: none;
    transition: transform 240ms ease, border-color 240ms ease, box-shadow 240ms ease;
  }

  .entry-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .visual-arrow {
    position: absolute;
    bottom: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgb(10 23 35 / 78%);
    color: #ffffff;
    font-size: 1rem;
    line-height: 1;
    transition: transform 240ms ease;
  }

  .illustrated-entry:hover .entry-visual,
  .entry-visual:focus-visible {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
  }

  .illustrated-entry:hover .entry-visual img,
  .entry-visual:focus-visible img {
    transform: scale(1.045);
  }

  .illustrated-entry:hover .visual-arrow,
  .entry-visual:focus-visible .visual-arrow {
    transform: translate(2px, -2px);
  }

  .entry-visual:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 740px) {
    .illustrated-entry {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }

    .entry-visual {
      max-width: 420px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-visual,
    .entry-visual img,
    .visual-arrow {
      transition: none;
    }

    .illustrated-entry:hover .entry-visual,
    .entry-visual:focus-visible,
    .illustrated-entry:hover .entry-visual img,
    .entry-visual:focus-visible img,
    .illustrated-entry:hover .visual-arrow,
    .entry-visual:focus-visible .visual-arrow {
      transform: none;
    }
  }
</style>
