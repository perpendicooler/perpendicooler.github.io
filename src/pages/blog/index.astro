---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugifyTag } from '../../utils/tags';

// Newest articles appear first.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Match each listing thumbnail to the lead illustration inside its article.
// Image files are already located in public/images/blog/.
const visuals: Record<string, { src: string; alt: string }> = {
  'knitting-capacity-optimization-from-baskets-to-milp': {
    src: '/images/blog/knitting-optimization-animated.svg',
    alt: 'Knitting allocation diagram showing machine-capacity baskets, style transfers and scheduling constraints',
  },
  'operations-research-bangladesh-manufacturing': {
    src: '/images/blog/manufacturing-flow-animated.svg',
    alt: 'Manufacturing decision-support workflow: observe, predict, optimize and validate',
  },
  'tic-tac-toe-extensive-form-game-theory': {
    src: '/images/blog/tic-tac-toe-game-animated.svg',
    alt: 'Tic-Tac-Toe extensive-form game tree',
  },
  'minimax-alpha-beta-pruning-python': {
    src: '/images/blog/minimax-pruning-animated.svg',
    alt: 'Minimax decision tree with an illustrative pruned branch',
  },
  'tictactoe-symmetry-burnsides-lemma': {
    src: '/images/blog/symmetry-burnside-animated.svg',
    alt: 'Tic-Tac-Toe board under rotations and reflections',
  },
  'orders-of-elements-in-additive-cyclic-groups': {
    src: '/images/blog/modular-wheels-z10-steps.svg',
    alt: 'Residue-wheel diagrams illustrating modular addition and the orders of cyclic-group elements',
  },
  'rubiks-cube-group-theory-combinatorics': {
    src: '/images/blog/rubiks-group-animated.svg',
    alt: 'Rubik’s Cube visualization of permutations and finite group theory',
  },
};
---

<BaseLayout
  title="Writing | Md Arif Hossain"
  description="Research-oriented writing on operations research, manufacturing analytics, combinatorics, games, algorithms, and group theory."
>
  <div class="container page-shell writing-page">
    <header class="page-header">
      <p class="eyebrow">WRITING / NOTES &amp; ESSAYS</p>
      <h1>Mathematics, algorithms, <em>and the world they model.</em></h1>
      <p class="page-lead">
        Research reflections, mathematical explanations, and computational experiments.
      </p>
    </header>

    <section class="content-section" aria-label="Articles and essays">
      <div class="writing-list">
        {posts.map((post) => {
          const href = `/blog/${post.id}/`;
          const visual = visuals[post.id];

          return (
            <article class="writing-entry writing-entry-visual">
              <div class="writing-copy">
                <p class="mini-label">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-GB', {
                      day: 'numeric', month: 'long', year: 'numeric',
                    })}
                  </time>
                </p>

                <h2><a href={href}>{post.data.title}</a></h2>
                <p class="writing-summary">{post.data.description}</p>

                <div class="tag-row">
                  {post.data.tags.map((tag) => (
                    <a class="tag-pill" href={`/blog/tags/${slugifyTag(tag)}/`}>{tag}</a>
                  ))}
                </div>
              </div>

              {visual && (
                <a
                  class="writing-thumbnail"
                  href={href}
                  aria-label={`Read article: ${post.data.title}`}
                >
                  <img
                    src={visual.src}
                    alt={visual.alt}
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="thumbnail-arrow" aria-hidden="true">↗</span>
                </a>
              )}
            </article>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Keep the existing clean Writing layout: text left, illustration right. */
  .writing-entry-visual {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 242px;
    align-items: center;
    gap: 30px;
    padding: 30px 4px;
  }

  .writing-copy {
    min-width: 0;
  }

  .writing-entry-visual h2 {
    margin: 5px 0 10px;
    font-size: clamp(1.25rem, 2.25vw, 1.8rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.026em;
  }

  .writing-entry-visual .mini-label {
    margin: 0;
  }

  .writing-entry-visual .writing-summary {
    max-width: 650px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.93rem;
    line-height: 1.65;
  }

  .writing-entry-visual .tag-row {
    margin: 14px 0 0;
    gap: 6px;
  }

  .writing-thumbnail {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: #0f2031;
    text-decoration: none;
    isolation: isolate;
  }

  .writing-thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 330ms ease, filter 330ms ease;
  }

  .writing-thumbnail:hover img,
  .writing-thumbnail:focus-visible img {
    transform: scale(1.045);
    filter: brightness(1.13);
  }

  .writing-thumbnail:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .thumbnail-arrow {
    position: absolute;
    right: 10px;
    bottom: 9px;
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    border: 1px solid rgb(150 223 247 / 30%);
    border-radius: 6px;
    background: rgb(12 30 44 / 85%);
    color: #9de5fa;
    font-size: 18px;
    line-height: 1;
    transition: transform 200ms ease;
  }

  .writing-thumbnail:hover .thumbnail-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 800px) {
    .writing-entry-visual {
      grid-template-columns: minmax(0, 1fr) 192px;
      gap: 18px;
    }
  }

  @media (max-width: 600px) {
    .writing-entry-visual {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 24px 3px;
    }

    .writing-thumbnail {
      width: min(100%, 355px);
    }

    .writing-entry-visual h2 {
      font-size: 1.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-thumbnail img,
    .thumbnail-arrow {
      transition: none;
    }
  }
</style>
