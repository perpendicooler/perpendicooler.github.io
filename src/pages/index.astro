---
import BaseLayout from "../layouts/BaseLayout.astro";


const presentations = [
  {
    label: "ICCIT 2026",
    title: "Fine-Grained Classification of Depression, Loneliness, and Fear in Bangla Social Media Text",
    authors: "Sadia Ahmed, Md Arif Hossain, Md Anisujjaman, Mohammed Minhaj Uddin, and Md. Shafiul Alam Forhad",
    venue: "29th International Conference on Computer and Information Technology (ICCIT 2026)",
    note: "Manuscript submitted · Under review",
  },
  {
    label: "ICSTEME 2023",
    title: "Rubik's Cube — An Application of Group Theory",
    authors: "Md Arif Hossain and Chandrani Nag",
    venue: "International Conference on Science, Technology, Engineering, Mathematics, and Education",
    note: "Contributory talk · 2023",
    certificate: "/Rubiks_Cube_Presentation_Certificate_2023.pdf",
  },
  {
    label: "ICSTEME 2023",
    title: "The Alternative Form of the Order of an Element in a Group Under Addition Modulo",
    authors: "Md Arif Hossain and Chandrani Nag",
    venue: "International Conference on Science, Technology, Engineering, Mathematics, and Education",
    note: "Contributory talk · 2023",
    certificate: "/Additive_Group_Order_Presentation_Certificate_2023.pdf",
  },
];

---

<BaseLayout
  title="Md Arif Hossain | Mathematics & Operations Research"
  description="Md Arif Hossain is a Mathematics graduate of SUST and a Business Intelligence Analyst at INDESORE Group. His interests include operations research, mathematical optimization, combinatorics, and manufacturing systems."
>
  <div class="minimal-home">
    <section class="hero-area" aria-labelledby="home-title">
      <p class="hero-eyebrow">MATHEMATICS <span aria-hidden="true">·</span> OPERATIONS RESEARCH <span aria-hidden="true">·</span> OPTIMIZATION</p>
      <h1 id="home-title" class="hero-title">
        Just because a system works
        <span>doesn't mean it works best.</span>
      </h1>

      <div class="intro-layout">
        <div class="intro-copy">
          <p class="hero-lead">
            My curiosity grew while studying mathematics at{' '}
            <a href="https://www.sust.edu/" target="_blank" rel="noopener noreferrer">Shahjalal University of Science and Technology (SUST)</a>,
            where questions about patterns and mathematical structures drew me toward research.
          </p>
          <p>
            Today, as a{' '}
            <strong>Business Intelligence Analyst at INDESORE Group</strong>,
            I explore how operations research, mathematical optimization, and data-driven models
            can improve decisions in complex manufacturing systems.
          </p>
          <p>
            My academic research at the SUST Research Center focused on matrix methods for{' '}
            <strong>partially ordered sets and lattices</strong>, under the supervision of{' '}
            <a href="https://www.sust.edu/departments/mat/faculty/salahuddin-mat%40sust.edu" target="_blank" rel="noopener noreferrer">Dr. Mohammad Salah Uddin</a>.
            {' '}I remain interested in where mathematical reasoning meets practical constraints.
          </p>
          <div class="hero-links" aria-label="Explore my work">
            <a href="/research/">Explore research <span aria-hidden="true">↗</span></a>
            <a href="/projects/">Selected projects <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <aside class="profile-aside" aria-label="Portrait and contact information">
          <img
            class="profile-portrait"
            src="/images/Arif_Profile.jpg"
            alt="Portrait of Md Arif Hossain"
            width="640"
            height="640"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="profile-details">
            <a href="mailto:arif39@student.sust.edu">arif39@student.sust.edu</a>
            <span>Dhaka, Bangladesh</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="contributions" aria-labelledby="contributions-heading">
      <div class="contribution-heading">
        <h2 id="contributions-heading">selected research &amp; presentations</h2>
        <a href="/research/" class="section-link">all research ↗</a>
      </div>

      <div class="publication-list">
        {presentations.map((item) => (
          <article class="publication-row">
            <span class="conference-tag">{item.label}</span>
            <div class="publication-copy">
              <h3>{item.title}</h3>
              <p>{item.authors}</p>
              <p class="publication-venue"><em>{item.venue}</em></p>
              <p class="publication-note">{item.note}</p>

              {item.certificate && (
                <p class="publication-note">
                  <a href={item.certificate} target="_blank" rel="noopener noreferrer">Presentation certificate ↗</a>
                </p>
              )}

            </div>
          </article>
        ))}
      </div>
    </section>

    <nav class="social-links" aria-label="Academic and professional links">
      <a href="mailto:arif39@student.sust.edu" aria-label="Email Md Arif Hossain" title="Email">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><rect x="2.2" y="4.8" width="19.6" height="14.4" rx="2"/><path d="m3 6 9 7 9-7"/></svg>
      </a>
      <a href="https://github.com/perpendicooler" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile" title="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.13c-3.1.67-3.75-1.32-3.75-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.6 1.2 3.23.92.1-.71.38-1.2.7-1.48-2.47-.28-5.06-1.23-5.06-5.49 0-1.21.43-2.2 1.15-2.97-.11-.28-.5-1.41.11-2.93 0 0 .94-.3 3.05 1.13a10.58 10.58 0 0 1 5.55 0c2.11-1.43 3.05-1.13 3.05-1.13.61 1.52.22 2.65.11 2.93.72.77 1.15 1.76 1.15 2.97 0 4.27-2.6 5.2-5.08 5.48.39.34.75 1.02.75 2.06v3.06c0 .3.2.65.76.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/md-arif-hossain-7067481a5/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" title="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M5.08 3.02a2.05 2.05 0 1 1-4.1 0 2.05 2.05 0 0 1 4.1 0ZM1.28 7.2h3.6V23h-3.6V7.2ZM7.33 7.2h3.45v2.16h.05c.48-.9 1.66-2.45 3.42-2.45 3.66 0 4.34 2.4 4.34 5.53V23H15v-9.4c0-2.25-.04-5.14-3.13-5.14-3.14 0-3.62 2.45-3.62 4.97V23H7.33V7.2Z" transform="translate(2 0) scale(.95 1)"/></svg>
      </a>
      <a href="/Md_Arif_Hossain_CV.pdf" target="_blank" rel="noopener noreferrer" aria-label="View academic CV" title="Academic CV" class="cv-link">CV</a>
    </nav>
  </div>
</BaseLayout>

<style>
  /* Homepage: same site-wide color tokens and font, including light mode. */
  :global(body::before) { display: none; }
  :global(.site-header) { background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  :global(.site-header .nav-shell) { width: min(calc(100% - 2.5rem), 980px); min-height: 64px; }
  :global(.site-header .brand) { font-size: .95rem; font-weight: 600; }
  :global(.site-header .brand-glyph) { display: none; }
  :global(.site-header .nav-anchor) { font-size: .89rem; background: transparent; }
  :global(.site-header .nav-cv) { font-size: .88rem; font-weight: 500; }
  :global(.site-footer) { display: none; }

  .minimal-home {
    width: min(calc(100% - 2.5rem), 970px);
    margin: 0 auto;
    padding: 0 0 74px;
  }
  .minimal-home h1,
  .minimal-home h2,
  .minimal-home h3,
  .minimal-home p { margin-top: 0; }
  .minimal-home a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .minimal-home a:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .hero-area { padding-top: clamp(48px, 6vw, 76px); }
  .hero-eyebrow {
    margin: 0 0 20px;
    color: var(--color-accent);
    font-family: var(--font-mono, monospace);
    font-size: .73rem;
    line-height: 1.6;
    font-weight: 500;
    letter-spacing: .125em;
  }
  .hero-eyebrow span { margin: 0 .28em; }
  .hero-title {
    max-width: 970px;
    margin: 0 0 clamp(30px, 4.2vw, 44px) !important;
    color: var(--color-text);
    font-size: clamp(2.65rem, 4.45vw, 3.55rem);
    font-weight: 730;
    line-height: 1.135;
    letter-spacing: -.048em;
    text-wrap: balance;
  }
  .hero-title span {
    display: block;
    color: var(--color-accent);
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 214px;
    gap: clamp(30px, 4vw, 50px);
    align-items: start;
  }
  .intro-copy { min-width: 0; max-width: 705px; }
  .intro-copy p {
    margin: 0 0 18px;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.73;
  }
  .intro-copy .hero-lead {
    color: var(--color-text);
    font-size: clamp(1rem, 1.3vw, 1.08rem);
    line-height: 1.73;
  }
  .intro-copy strong {
    color: var(--color-text);
    font-weight: 650;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    padding-top: 9px;
  }
  .hero-links a {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-weight: 650;
    font-size: .91rem;
    line-height: 1.5;
  }
  .hero-links a span { transition: transform .18s ease; }
  .hero-links a:hover span { transform: translate(2px, -2px); }

  .profile-aside {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 14px;
    padding-top: 5px;
  }
  .profile-portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 29%;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: var(--color-surface);
  }
  .profile-details {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--color-text-muted);
    font-size: .83rem;
    line-height: 1.55;
  }

  .contributions {
    margin-top: clamp(52px, 7vw, 82px);
    padding-top: 26px;
    border-top: 1px solid var(--color-border);
  }
  .contribution-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 25px;
  }
  .contribution-heading h2 {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(1.45rem, 2.6vw, 1.83rem);
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1.25;
  }
  .section-link { flex-shrink: 0; white-space: nowrap; font-size: .89rem; }
  .publication-list { display: flex; flex-direction: column; gap: 27px; }
  .publication-row {
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }
  .conference-tag {
    display: block;
    margin-top: 5px;
    border-radius: 3px;
    background: var(--color-accent);
    color: var(--color-bg);
    text-align: center;
    padding: 5px 6px;
    font-size: .72rem;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: .025em;
  }
  .publication-copy h3 {
    margin: 0 0 5px;
    color: var(--color-text);
    font-size: 1.04rem;
    line-height: 1.5;
    font-weight: 630;
  }
  .publication-copy p {
    margin: 3px 0;
    color: var(--color-text-muted);
    font-size: .9rem;
    line-height: 1.55;
  }
  .publication-copy .publication-venue { color: var(--color-text-muted); }
  .publication-copy .publication-note {
    margin-top: 5px;
    color: var(--color-text-subtle);
    font-size: .81rem;
  }
  .social-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 21px;
    padding-top: 64px;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    color: var(--color-text);
  }
  .social-links a:hover { color: var(--color-accent); }
  .social-links svg { width: 29px; height: 29px; }
  .social-links .cv-link {
    width: 36px;
    height: 30px;
    border: 2px solid currentColor;
    border-radius: 5px;
    font-size: 1rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -.03em;
  }

  @media (max-width: 800px) {
    .intro-layout { grid-template-columns: minmax(0, 1fr) 185px; gap: 26px; }
    .hero-title { font-size: clamp(2.45rem, 5vw, 3.55rem); }
    .intro-copy p { font-size: .97rem; }
  }
  @media (max-width: 650px) {
    .minimal-home { width: calc(100% - 2rem); padding-bottom: 55px; }
    .hero-area { padding-top: 42px; }
    .hero-eyebrow { font-size: .63rem; letter-spacing: .085em; }
    .hero-title {
      margin-bottom: 28px !important;
      font-size: clamp(2.1rem, 8vw, 3rem);
      line-height: 1.16;
    }
    .intro-layout { grid-template-columns: 1fr; gap: 29px; }
    .profile-aside {
      width: 100%;
      flex-direction: row;
      align-items: center;
      gap: 18px;
      padding-top: 0;
    }
    .profile-portrait { width: 125px; max-width: 37%; flex: 0 0 auto; }
    .profile-details { font-size: .81rem; }
    .contributions { margin-top: 59px; }
    .contribution-heading { align-items: start; }
    .contribution-heading h2 { font-size: 1.42rem; }
    .section-link { margin-top: 4px; font-size: .8rem; }
    .publication-row { grid-template-columns: 1fr; gap: 8px; }
    .conference-tag { justify-self: start; width: auto; padding-inline: 10px; }
    .social-links { padding-top: 47px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-links a span { transition: none; }
  }
</style>
