---
import BaseLayout from "../layouts/BaseLayout.astro";

// Upload your own photograph to public/images/Arif_Profile.jpg,
// then change this value to "/images/Arif_Profile.jpg".
const portrait = "/images/Arif_Profile.jpg";


const presentations = [
  {
    label: "ICCIT 2026",
    title: "Fine-Grained Classification of Depression, Loneliness, and Fear in Bangla Social Media Text",
    authors: "Sadia Ahmed, Md Arif Hossain, Md Anisujjaman, Mohammed Minhaj Uddin, and Md. Shafiul Alam Forhad",
    venue: "29th International Conference on Computer and Information Technology (ICCIT 2026)",
    note: "Manuscript submitted · Under review",
  },
  {
    label: "ICSTEME 2023",
    title: "Rubik's Cube — An Application of Group Theory",
    authors: "Md Arif Hossain and Chandrani Nag",
    venue: "International Conference on Science, Technology, Engineering, Mathematics, and Education",
    note: "Contributory talk · 2023",
  },
  {
    label: "ICSTEME 2023",
    title: "The Alternative Form of the Order of an Element in a Group Under Addition Modulo",
    authors: "Md Arif Hossain and Chandrani Nag",
    venue: "International Conference on Science, Technology, Engineering, Mathematics, and Education",
    note: "Contributory talk · 2023",
  },
];

---

<BaseLayout
  title="Md Arif Hossain | Mathematics & Operations Research"
  description="Md Arif Hossain is a Mathematics graduate of SUST and a Business Intelligence Analyst at INDESORE Group. His interests include operations research, mathematical optimization, combinatorics, and manufacturing systems."
>
  <div class="minimal-home">
    <section class="intro-layout" aria-labelledby="home-title">
      <div class="intro-copy">
        <h1 id="home-title">Md Arif Hossain</h1>
        <p>
          Hi! I'm <strong>Arif</strong>, a Mathematics graduate from
          <a href="https://www.sust.edu/" target="_blank" rel="noopener noreferrer">Shahjalal University of Science and Technology (SUST)</a>
          and currently a <strong>Business Intelligence Analyst</strong> at
          INDESORE Group in Bangladesh.
        </p>
        <p>
          I previously worked as a research student at the SUST Research Center,
          investigating matrix methods for <strong>partially ordered sets and lattices </strong>
          under the guidance of <strong> <a href="https://www.sust.edu/departments/mat/faculty/salahuddin-mat%40sust.edu" target="_blank" rel="noopener noreferrer" > Dr. Mohammad Salah Uddin </a> </strong>.
        </p>
        <p>
          My interests lie in <strong>Operations Research, Mathematical Optimization,
          Combinatorial Optimization, and Machine Learning</strong>, particularly
          their applications to real-world decision-making and manufacturing systems.
          I'm always open to academic discussions and collaboration.
        </p>
      </div>

      <aside class="profile-aside" aria-label="Profile and contact information">
        <img
          class="profile-photo"
          src={portrait}
          width="320"
          height="345"
          alt="Portrait area for Md Arif Hossain"
          decoding="async"
        />
        <div class="profile-details">
          <a href="mailto:arif39@student.sust.edu">arif39@student.sust.edu</a>
          <span>Dhaka, Bangladesh</span>
        </div>
      </aside>
    </section>

    <section class="contributions" aria-labelledby="contributions-heading">
      <div class="contribution-heading">
        <h2 id="contributions-heading">selected research &amp; presentations</h2>
        <a href="/research/" class="section-link">all research ↗</a>
      </div>

      <div class="publication-list">
        {presentations.map((item) => (
          <article class="publication-row">
            <span class="conference-tag">{item.label}</span>
            <div class="publication-copy">
              <h3>{item.title}</h3>
              <p>{item.authors}</p>
              <p class="publication-venue"><em>{item.venue}</em></p>
              <p class="publication-note">{item.note}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <nav class="social-links" aria-label="Academic and professional links">
      <a href="mailto:arif39@student.sust.edu" aria-label="Email Md Arif Hossain" title="Email">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><rect x="2.2" y="4.8" width="19.6" height="14.4" rx="2"/><path d="m3 6 9 7 9-7"/></svg>
      </a>
      <a href="https://github.com/perpendicooler" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile" title="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.13c-3.1.67-3.75-1.32-3.75-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.6 1.2 3.23.92.1-.71.38-1.2.7-1.48-2.47-.28-5.06-1.23-5.06-5.49 0-1.21.43-2.2 1.15-2.97-.11-.28-.5-1.41.11-2.93 0 0 .94-.3 3.05 1.13a10.58 10.58 0 0 1 5.55 0c2.11-1.43 3.05-1.13 3.05-1.13.61 1.52.22 2.65.11 2.93.72.77 1.15 1.76 1.15 2.97 0 4.27-2.6 5.2-5.08 5.48.39.34.75 1.02.75 2.06v3.06c0 .3.2.65.76.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/md-arif-hossain-7067481a5/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" title="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M5.08 3.02a2.05 2.05 0 1 1-4.1 0 2.05 2.05 0 0 1 4.1 0ZM1.28 7.2h3.6V23h-3.6V7.2ZM7.33 7.2h3.45v2.16h.05c.48-.9 1.66-2.45 3.42-2.45 3.66 0 4.34 2.4 4.34 5.53V23H15v-9.4c0-2.25-.04-5.14-3.13-5.14-3.14 0-3.62 2.45-3.62 4.97V23H7.33V7.2Z" transform="translate(2 0) scale(.95 1)"/></svg>
      </a>
      <a href="/Md_Arif_Hossain_CV.pdf" target="_blank" rel="noopener noreferrer" aria-label="View academic CV" title="Academic CV" class="cv-link">CV</a>
    </nav>
  </div>
</BaseLayout>

<style>
  /* Homepage-only reset: neutral charcoal and restrained blue links. */
  :global(body) { background: #1b1b1b; color: #ececec; }
  :global(body::before) { display: none; }
  :global(.site-header) { background: #1b1b1b; border-bottom: 1px solid #333; }
  :global(.site-header .nav-shell) { width: min(calc(100% - 2.5rem), 980px); min-height: 60px; }
  :global(.site-header .brand) { color: #e7e7e7; font-size: .92rem; font-weight: 500; }
  :global(.site-header .brand-glyph) { display: none; }
  :global(.site-header .brand-stop) { color: #369ec5; }
  :global(.site-header .nav-anchor) { color: #bfc0c2; font-size: .9rem; background: none; }
  :global(.site-header .nav-anchor:hover), :global(.site-header .nav-anchor.current) { color: #36a8d6; background: none; }
  :global(.site-header .nav-cv) { border: 0; color: #c7c7c7; font-size: .9rem; font-weight: 400; padding: .4rem; }
  :global(.site-header .nav-cv:hover) { color: #36a8d6; background: none; }
  :global(.site-footer) { display: none; }
  :global(.back-to-top) { display: none !important; }

  .minimal-home { max-width: 970px; width: calc(100% - 2.5rem); margin: 0 auto; padding: 52px 0 72px; }
  .intro-layout { display: grid; grid-template-columns: minmax(0, 1fr) 285px; gap: 46px; align-items: start; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin: 0 0 20px; font-size: clamp(2.2rem, 4vw, 2.8rem); font-weight: 400; letter-spacing: -.04em; line-height: 1.2; color: #e8e8e8; }
  .intro-copy { padding-top: 2px; }
  .intro-copy p { font-size: 1rem; line-height: 1.63; color: #e0e0e0; margin: 0 0 18px; }
  .intro-copy strong { font-weight: 650; color: #f4f4f4; }
  .minimal-home a { color: #39aad8; text-decoration: none; }
  .minimal-home a:hover { color: #7fd9f2; text-decoration: underline; }
  .profile-aside { padding-top: 34px; }
  .profile-photo { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1.08; object-fit: cover; border-radius: 4px; background: #292929; border: 1px solid #383838; }
  .profile-details { margin-top: 13px; display: flex; flex-direction: column; gap: 2px; font: .84rem/1.5 var(--font-mono, monospace); overflow-wrap: anywhere; color: #d5d5d5; }
  .contributions { margin-top: 62px; }
  .contribution-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  h2 { margin: 0 0 25px; font-size: clamp(1.55rem, 3vw, 2rem); font-weight: 400; letter-spacing: -.025em; line-height: 1.25; color: #ececec; }
  .section-link { white-space: nowrap; font-size: .89rem; }
  .publication-list { display: flex; flex-direction: column; gap: 21px; }
  .publication-row { display: grid; grid-template-columns: 123px minmax(0, 1fr); gap: 22px; align-items: start; }
  .conference-tag { display: block; margin-top: 4px; border-radius: 3px; background: #389dc0; color: #10191e; text-align: center; padding: 3px 6px; font-size: .74rem; line-height: 1.3; font-weight: 650; letter-spacing: .02em; }
  h3 { color: #f3f3f3; font-size: 1rem; font-weight: 620; margin-bottom: 2px; line-height: 1.48; }
  .publication-copy p { font-size: .9rem; line-height: 1.48; margin: 2px 0; color: #ddd; }
  .publication-copy .publication-venue { color: #d1d1d1; }
  .publication-copy .publication-note { color: #a4a4a4; font-size: .79rem; margin-top: 3px; }
  .social-links { display: flex; justify-content: center; align-items: center; gap: 20px; padding-top: 55px; }
  .social-links a { color: #e5e5e5; display: inline-flex; justify-content: center; align-items: center; width: 38px; height: 38px; }
  .social-links a:hover { color: #39aad8; }
  .social-links svg { width: 29px; height: 29px; }
  .social-links .cv-link { font: 700 1.03rem/1 var(--font-sans, sans-serif); letter-spacing: -.03em; border: 2px solid currentColor; border-radius: 5px; width: 36px; height: 30px; }
  @media (max-width: 800px) {
    .minimal-home { padding-top: 38px; }
    .intro-layout { grid-template-columns: minmax(0, 1fr) 240px; gap: 26px; }
    .profile-aside { padding-top: 30px; }
    .intro-copy p { font-size: .95rem; }
  }
  @media (max-width: 650px) {
    .minimal-home { width: calc(100% - 2rem); padding: 35px 0 55px; }
    .intro-layout { display: flex; flex-direction: column; gap: 14px; }
    .profile-aside { padding-top: 0; width: 100%; display: flex; align-items: center; gap: 17px; }
    .profile-photo { width: 136px; height: 148px; flex-shrink: 0; }
    .profile-details { margin-top: 0; font-size: .78rem; }
    .contributions { margin-top: 43px; }
    .publication-row { grid-template-columns: 1fr; gap: 8px; }
    .conference-tag { justify-self: start; width: auto; padding-inline: 9px; }
    .contribution-heading { align-items: start; }
    .section-link { margin-top: 5px; font-size: .78rem; }
    .social-links { padding-top: 44px; }
  }
  @media (prefers-reduced-motion: reduce) { .minimal-home * { transition: none; } }
</style>
