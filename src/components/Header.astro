---
const navigation = [
  { label: 'Home', href: '/' }, { label: 'About', href: '/about/' },
  { label: 'Research', href: '/research/' }, { label: 'Projects', href: '/projects/' },
  { label: 'Writing', href: '/blog/' }, { label: 'Contact', href: '/contact/' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container nav-shell">
    <a href="/" class="brand" aria-label="Md Arif Hossain, homepage">
      <span class="brand-glyph" aria-hidden="true">∑</span>
      <span>Arif Hossain<span class="brand-stop">.</span></span>
    </a>
    <nav aria-label="Primary navigation" class="nav-links">
      {navigation.map(item => (
        <a href={item.href} class:list={['nav-anchor', {'current': item.href === '/' ? path === '/' : path.startsWith(item.href)}]} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a href="/Md_Arif_Hossain_CV.pdf" class="nav-cv" target="_blank" rel="noopener">CV ↗</a>
  </div>
</header>
